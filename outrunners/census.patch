+/* ---- census (naomi port study, local only) ---- */
+static void census_frame(int drawn)
+{
+	if (!census_checked) { const char *p = getenv("ORUNNERS_CENSUS"); census_checked = 1; if (p) census_file = fopen(p, "w"); }
+	if (!census_file) return;
+	fprintf(census_file, "drawn=%02x ctl00=%04x off02=%04x win06=%04x line04=%04x more8e=%04x z0=%03x/%03x z1=%03x/%03x mix4e=%04x mix4c=%04x mix3e=%04x",
+		drawn, video_register(0), video_register(2), video_register(6), video_register(4), video_register(0x8e),
+		video_register(0x50)&0xfff, video_register(0x52)&0xfff, video_register(0x54)&0xfff, video_register(0x56)&0xfff,
+		mixer_register(0,0x4e), mixer_register(0,0x4c), mixer_register(0,0x3e));
+	fprintf(census_file, " pri=");
+	for (int i = 0; i < 6; i++) fprintf(census_file, "%04x,", mixer_register(0, 0x20 + 2*i));
+	fprintf(census_file, " bl=");
+	for (int i = 0; i < 6; i++) fprintf(census_file, "%04x,", mixer_register(0, 0x30 + 2*i));
+	fprintf(census_file, " off=");
+	for (int i = 0; i < 6; i++) fprintf(census_file, "%04x,", mixer_register(0, 0x40 + 2*i));
+	fprintf(census_file, " banks=");
+	{ static uint8_t all[1024]; int tot = 0; for (int l = 0; l < 8; l++) { int n = 0; for (int b = 0; b < 1024; b++) { n += census_banks[l][b]; if (census_banks[l][b] && !all[b]) all[b] = 1; } fprintf(census_file, "%d,", n); }
+	  int u = 0; uint8_t any[1024] = {0}; for (int l = 0; l < 8; l++) for (int b = 0; b < 1024; b++) any[b] |= census_banks[l][b]; for (int b = 0; b < 1024; b++) { u += any[b]; tot += all[b]; } fprintf(census_file, " ubanks=%d everbanks=%d", u, tot); }
+	memset(census_banks, 0, sizeof census_banks);
+	fprintf(census_file, " spr=%d zoom=%d shadow=%d ind=%d b8=%d ram=%d clip=%d area=%ld extra=%d\n",
+		census_s.sprites, census_s.zoomed, census_s.shadow, census_s.indirect, census_s.bits8, census_s.from_ram, census_s.clipcmd, census_s.area, video.extra_used);
+	memset(&census_s, 0, sizeof census_s);
+}
