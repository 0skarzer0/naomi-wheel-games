+++ b/ports/naomi/naomi_log.c
@@ -123,11 +123,175 @@ void naomi_show_log(const char *why)
 	show_log(why, 0);
 }
 
+/* ---- misaligned loads and stores ----
+
+   The V60 reads and writes words at any address, and the game's C does as its code did (src/objects/scenery.c's
+   flashing scenery reads a palette list at an odd address, found on the board, 2026-11-13); the SH-4 takes an
+   address error instead. The handler does the access a byte at a time (little endian, as the SH-4's) and goes
+   on after the instruction (in a branch's delay slot too: then the branch is done as well). Not the FPU's
+   moves: those stay errors. */
+
+static uint32_t load_bytes(uint32_t address, int size)
+{
+	const volatile uint8_t *at = (const volatile uint8_t *)(uintptr_t)address;
+	uint32_t value = 0;
+
+	for (int index = size - 1; index >= 0; index--)
+		value = value << 8 | at[index];
+	return size == 2 ? (uint32_t)(int32_t)(int16_t)value : value;
+}
+
+static void store_bytes(uint32_t address, uint32_t value, int size)
+{
+	volatile uint8_t *at = (volatile uint8_t *)(uintptr_t)address;
+
+	for (int index = 0; index < size; index++, value >>= 8)
+		at[index] = (uint8_t)value;
+}
+
+static bool emulate_access(irq_context_t *context, uint16_t op)
+{
+	const int n = op >> 8 & 15, m = op >> 4 & 15, low = op & 15;
+	uint32_t *r = context->r;
+
+	switch (op >> 12)
+	{
+		case 0x6:    /* mov.w/l @Rm,Rn and @Rm+,Rn */
+			if (low == 1 || low == 2)
+				r[n] = load_bytes(r[m], low == 1 ? 2 : 4);
+			else if (low == 5 || low == 6)
+			{
+				const int size = low == 5 ? 2 : 4;
+				const uint32_t value = load_bytes(r[m], size);
+
+				if (n != m)
+					r[m] += (uint32_t)size;
+				r[n] = value;
+			}
+			else
+				return false;
+			break;
+		case 0x5:    /* mov.l @(disp,Rm),Rn */
+			r[n] = load_bytes(r[m] + (uint32_t)(low * 4), 4);
+			break;
+		case 0x2:    /* mov.w/l Rm,@Rn and Rm,@-Rn */
+			if (low == 1 || low == 2)
+				store_bytes(r[n], r[m], low == 1 ? 2 : 4);
+			else if (low == 5 || low == 6)
+			{
+				const int size = low == 5 ? 2 : 4;
+
+				store_bytes(r[n] - (uint32_t)size, r[m], size);
+				r[n] -= (uint32_t)size;
+			}
+			else
+				return false;
+			break;
+		case 0x1:    /* mov.l Rm,@(disp,Rn) */
+			store_bytes(r[n] + (uint32_t)(low * 4), r[m], 4);
+			break;
+		case 0x0:    /* @(R0,Rm) and @(R0,Rn) */
+			if (low == 0xd || low == 0xe)
+				r[n] = load_bytes(r[0] + r[m], low == 0xd ? 2 : 4);
+			else if (low == 5 || low == 6)
+				store_bytes(r[0] + r[n], r[m], low == 5 ? 2 : 4);
+			else
+				return false;
+			break;
+		case 0x8:
+			if (n == 5)         /* mov.w @(disp,Rm),R0 */
+				r[0] = load_bytes(r[m] + (uint32_t)(low * 2), 2);
+			else if (n == 1)    /* mov.w R0,@(disp,Rn) */
+				store_bytes(r[m] + (uint32_t)(low * 2), r[0], 2);
+			else
+				return false;
+			break;
+		case 0xc:
+			switch (n)
+			{
+				case 1: store_bytes(context->gbr + (uint32_t)(op & 0xff) * 2, r[0], 2); break;
+				case 2: store_bytes(context->gbr + (uint32_t)(op & 0xff) * 4, r[0], 4); break;
+				case 5: r[0] = load_bytes(context->gbr + (uint32_t)(op & 0xff) * 2, 2); break;
+				case 6: r[0] = load_bytes(context->gbr + (uint32_t)(op & 0xff) * 4, 4); break;
+				default: return false;
+			}
+			break;
+		default:
+			return false;
+	}
+	return true;
+}
+
+/* A delayed branch, its target if it is taken (in *target; *taken), whether it is one at all */
+static bool delayed_branch(const irq_context_t *context, uint16_t op, uint32_t *target, bool *taken)
+{
+	const uint32_t pc = context->pc;
+	const int n = op >> 8 & 15;
+
+	*taken = true;
+	if ((op & 0xf000) == 0xa000 || (op & 0xf000) == 0xb000)    /* bra, bsr */
+		*target = pc + 4 + (uint32_t)((int32_t)((op & 0xfff) << 20) >> 19);
+	else if ((op & 0xff00) == 0x8d00 || (op & 0xff00) == 0x8f00)    /* bt/s, bf/s */
+	{
+		*target = pc + 4 + (uint32_t)((int32_t)(int8_t)(op & 0xff) * 2);
+		*taken = ((context->sr & 1) != 0) == ((op & 0xff00) == 0x8d00);
+	}
+	else if ((op & 0xf0ff) == 0x402b || (op & 0xf0ff) == 0x400b)    /* jmp, jsr @Rn */
+		*target = context->r[n];
+	else if (op == 0x000b)    /* rts */
+		*target = context->pr;
+	else if ((op & 0xf0ff) == 0x0023 || (op & 0xf0ff) == 0x0003)    /* braf, bsrf Rn */
+		*target = pc + 4 + context->r[n];
+	else
+		return false;
+	return true;
+}
+
+static bool emulate_misaligned(irq_context_t *context)
+{
+	const uint16_t op = *(const uint16_t *)(uintptr_t)context->pc;
+	uint32_t target;
+	bool taken;
+
+	if (delayed_branch(context, op, &target, &taken))
+	{
+		/* the access is in the branch's delay slot: it, then the branch */
+		const uint32_t after = context->pc + 4;
+		const bool subroutine = (op & 0xf000) == 0xb000 || (op & 0xf0ff) == 0x400b || (op & 0xf0ff) == 0x0003;
+
+		if (!emulate_access(context, *(const uint16_t *)(uintptr_t)(context->pc + 2)))
+			return false;
+		if (subroutine)
+			context->pr = after;
+		context->pc = taken ? target : after;
+	}
+	else
+	{
+		if (!emulate_access(context, op))
+			return false;
+		context->pc += 2;
+	}
+	orunners_naomi_live.misaligned++;
+	return true;
+}
+
 /* An exception nothing handles (an address error, an illegal instruction...): where it was, then the console on
    the screen. Without this KallistiOS prints the registers and stops, and a cabinet shows black */
 static void on_exception(irq_t code, irq_context_t *context, void *data)
 {
 	(void)data;
+	if ((code == EXC_DATA_ADDRESS_READ || code == EXC_DATA_ADDRESS_WRITE) && emulate_misaligned(context))
+	{
+		static uint32_t told;
+
+		if (told < 8)
+		{
+			told++;
+			printf("NAOMI: a misaligned access (address %08lx), done a byte at a time\n",
+				(unsigned long)*(volatile uint32_t *)0xff00000c);
+		}
+		return;
+	}
 	printf("NAOMI EXCEPTION %03lx at pc %08lx pr %08lx, address %08lx, r15 %08lx, thread %s\n",
 		(unsigned long)code, (unsigned long)context->pc, (unsigned long)context->pr,
 		(unsigned long)*(volatile uint32_t *)0xff00000c, (unsigned long)context->r[15],
@@ -203,6 +367,8 @@ int naomi_boot(void)
 	printf("NAOMI: OutRunners, KOS_SUBARCH=naomi\n");
 	main_thread = thd_get_current();
 	irq_set_handler(EXC_UNHANDLED_EXC, on_exception, NULL);
+	irq_set_handler(EXC_DATA_ADDRESS_READ, on_exception, NULL);
+	irq_set_handler(EXC_DATA_ADDRESS_WRITE, on_exception, NULL);
 	irq_set_handler(EXC_DOUBLE_FAULT, on_exception, NULL);
 	orunners_naomi_live.log_lines = (uint32_t)(uintptr_t)lines;
 	orunners_naomi_live.log_count = LOG_LINES;
diff --git a/ports/naomi/pvr_video.c b/ports/naomi/pvr_video.c
new file mode 100644
index 0000000..57ea51e
--- /dev/null
+++ b/ports/naomi/pvr_video.c
@@ -0,0 +1,253 @@
+/**
+ *    Name:        pvr_video.c
+ *    Description: the frame on the NAOMI's PowerVR2 (CLX2): the scene's images (s32/video_scene.h) as textures in
+ *                 video memory, its quads as punch-through polygons, 320 x 224 doubled to 640 x 448 in a 640 x 480
+ *                 screen (KallistiOS's pvr)
+ *    Created:     13-11-2026
+ *
+ *    license:BSD-3-Clause
+ *    Images are ARGB1555 textures, not twiddled (the CPU writes their texels as they change: a tile, a row of the
+ *    bitmap, a sprite). Bit 15 is the punch-through's alpha: the pens that are not drawn. Depth is the mixer's
+ *    priority (higher in front, compared GEQUAL); the background, untextured quads, the backdrop's colour.
+ *    Colour offsets: the vertex colour modulates the texels, the offset colour adds.
+ */
+#include <kos.h>
+#include <dc/pvr.h>
+#include <arch/timer.h>
+
+#include "s32/video_scene.h"
+#include "pvr_video.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define IMAGES 2048
+#define TOP    16          /* (480 - 448) / 2 */
+
+static struct
+{
+	pvr_ptr_t base[IMAGES];
+	int width[IMAGES], height[IMAGES];
+	size_t free_at_start;
+	int images, failed;
+} pvr_images;
+
+static int image_create(void *context, int width, int height)
+{
+	(void)context;
+	for (int image = 1; image < IMAGES; image++)
+		if (!pvr_images.base[image])
+		{
+			pvr_ptr_t base;
+
+			/* (leave 64 KB: KallistiOS's own) */
+			if (pvr_mem_available() < (size_t)width * (size_t)height * 2 + (64 << 10)
+				|| !(base = pvr_mem_malloc((size_t)width * (size_t)height * 2)))
+			{
+				pvr_images.failed++;
+				return 0;
+			}
+			pvr_images.base[image] = base;
+			pvr_images.width[image] = width;
+			pvr_images.height[image] = height;
+			pvr_images.images++;
+			return image;
+		}
+	return 0;
+}
+
+static void image_free(void *context, int image)
+{
+	(void)context;
+	if (image > 0 && image < IMAGES && pvr_images.base[image])
+	{
+		pvr_mem_free(pvr_images.base[image]);
+		pvr_images.base[image] = NULL;
+		pvr_images.images--;
+	}
+}
+
+/* Texels into video memory, 32 bits at a time (it takes no byte writes; x and width are even) */
+static void image_write(void *context, int image, int x, int y, int width, int height, const uint16_t *pixels, int stride)
+{
+	(void)context;
+	for (int row = 0; row < height; row++)
+	{
+		volatile uint32_t *out = (volatile uint32_t *)((uint16_t *)pvr_images.base[image]
+			+ (size_t)(y + row) * (size_t)pvr_images.width[image] + (size_t)x);
+		const uint16_t *in = &pixels[(size_t)row * (size_t)stride];
+
+		for (int column = 0; column < width; column += 2)
+			*out++ = (uint32_t)in[column] | (uint32_t)in[column + 1] << 16;
+	}
+}
+
+static const s32_scene_backend backend = { NULL, image_create, image_free, image_write };
+
+void pvr_video_start(void)
+{
+	pvr_init_params_t params = {
+		/* opaque, opaque modifiers, translucent, translucent modifiers, punch-through */
+		.opb_sizes = { PVR_BINSIZE_16, PVR_BINSIZE_0, PVR_BINSIZE_0, PVR_BINSIZE_0, PVR_BINSIZE_16 },
+		.vertex_buf_size = 512 * 1024,
+		.opb_overflow_count = 3,
+	};
+
+	pvr_init(&params);
+	pvr_set_bg_color(0, 0, 0);
+	pvr_images.free_at_start = pvr_mem_available();
+	printf("NAOMI: PowerVR2 on, %lu bytes of video memory for textures\n", (unsigned long)pvr_images.free_at_start);
+	s32_scene_start(&backend, true);
+}
+
+/* A header, straight to the tile accelerator through the store queues (direct rendering) */
+static void send_header(const pvr_poly_hdr_t *header)
+{
+	uint32_t *out = (uint32_t *)pvr_dr_target();
+	const uint32_t *in = (const uint32_t *)header;
+
+	for (int index = 0; index < 8; index++)
+		out[index] = in[index];
+	pvr_dr_commit(out);
+}
+
+static void send_vertex(uint32_t flags, float x, float y, float z, float u, float v, uint32_t argb, uint32_t oargb)
+{
+	pvr_vertex_t *vertex = (pvr_vertex_t *)pvr_dr_target();
+
+	vertex->flags = flags;
+	vertex->x = x;
+	vertex->y = y;
+	vertex->z = z;
+	vertex->u = u;
+	vertex->v = v;
+	vertex->argb = argb;
+	vertex->oargb = oargb;
+	pvr_dr_commit(vertex);
+}
+
+/* One quad as a strip of four vertices, 320 x 224 to the screen's 640 x 448 */
+static void quad_vertices(const s32_scene_quad *quad, float width, float height)
+{
+	const float x0 = quad->x0 * 2, x1 = quad->x1 * 2, y0 = quad->y0 * 2 + TOP, y1 = quad->y1 * 2 + TOP;
+	const float u0 = quad->u0 / width, u1 = quad->u1 / width, v0 = quad->v0 / height, v1 = quad->v1 / height;
+	const uint32_t argb = 0xff000000u | quad->modulate;
+
+	send_vertex(PVR_CMD_VERTEX, x0, y1, quad->z, u0, v1, argb, quad->add);
+	send_vertex(PVR_CMD_VERTEX, x0, y0, quad->z, u0, v0, argb, quad->add);
+	send_vertex(PVR_CMD_VERTEX, x1, y1, quad->z, u1, v1, argb, quad->add);
+	send_vertex(PVR_CMD_VERTEX_EOL, x1, y0, quad->z, u1, v0, argb, quad->add);
+}
+
+void pvr_video_frame(pvr_video_stats *stats)
+{
+	const uint64_t start = timer_us_gettime64();
+	const s32_scene_frame *frame = s32_scene_build();
+	const uint64_t built = timer_us_gettime64();
+	uint64_t ready;
+	pvr_poly_cxt_t context;
+	pvr_poly_hdr_t header;
+	int last_image = -1;
+	bool last_add = false;
+	static uint16_t order[4096];
+	int ordered;
+
+	if (stats)
+	{
+		stats->quads = frame->count;
+		stats->images_drawn = frame->images_drawn;
+		stats->texels_drawn = frame->texels_drawn;
+		stats->missing = frame->missing;
+		stats->images = pvr_images.images;
+		stats->failed = pvr_images.failed;
+		stats->video_memory_free = (uint32_t)pvr_mem_available();
+	}
+	pvr_wait_ready();
+	ready = timer_us_gettime64();
+	pvr_scene_begin();
+
+	/* the plain colours (the backdrop) in the opaque list, the textured quads punch-through */
+	pvr_list_begin(PVR_LIST_OP_POLY);
+	pvr_poly_cxt_col(&context, PVR_LIST_OP_POLY);
+	context.depth.comparison = PVR_DEPTHCMP_GEQUAL;
+	pvr_poly_compile(&header, &context);
+	send_header(&header);
+	for (int index = 0; index < frame->count; index++)
+	{
+		const s32_scene_quad *quad = &frame->quads[index];
+		s32_scene_quad plain;
+		const uint16_t c = quad->colour;
+		const uint32_t red = (uint32_t)(c >> 10 & 31) * 255 / 31, green = (uint32_t)(c >> 5 & 31) * 255 / 31,
+			blue = (uint32_t)(c & 31) * 255 / 31;
+
+		if (quad->image)
+			continue;
+		/* (the colour itself times the modulate, plus the add, worked out here) */
+		plain = *quad;
+		plain.modulate = 0;
+		for (int shift = 0; shift <= 16; shift += 8)
+		{
+			const uint32_t value = (shift == 16 ? red : shift == 8 ? green : blue) * (quad->modulate >> shift & 255) / 255
+				+ (quad->add >> shift & 255);
+
+			plain.modulate |= (value > 255 ? 255 : value) << shift;
+		}
+		plain.add = 0;
+		quad_vertices(&plain, 1, 1);
+	}
+	pvr_list_finish();
+
+	/* textured quads by image, so that a header is sent once an image (and offset colour): the order does not
+	   matter, depth decides (quads of a layer do not overlap; sprites have depths of their own) */
+	{
+		static uint16_t count[IMAGES + 1];
+		int at = 0;
+
+		memset(count, 0, sizeof(count));
+		for (int index = 0; index < frame->count; index++)
+			if (frame->quads[index].image)
+				count[frame->quads[index].image]++;
+		for (int image = 0; image <= IMAGES; image++)
+		{
+			const int many = count[image];
+
+			count[image] = (uint16_t)at;
+			at += many;
+		}
+		for (int index = 0; index < frame->count; index++)
+			if (frame->quads[index].image)
+				order[count[frame->quads[index].image]++] = (uint16_t)index;
+		ordered = at;
+	}
+	pvr_list_begin(PVR_LIST_PT_POLY);
+	for (int place = 0; place < ordered; place++)
+	{
+		const s32_scene_quad *quad = &frame->quads[order[place]];
+		const bool add = quad->add != 0;
+
+		if (!quad->image || !pvr_images.base[quad->image])
+			continue;
+		if (quad->image != last_image || add != last_add)
+		{
+			pvr_poly_cxt_txr(&context, PVR_LIST_PT_POLY, PVR_TXRFMT_ARGB1555 | PVR_TXRFMT_NONTWIDDLED,
+				pvr_images.width[quad->image], pvr_images.height[quad->image], pvr_images.base[quad->image],
+				PVR_FILTER_NONE);
+			context.depth.comparison = PVR_DEPTHCMP_GEQUAL;
+			context.txr.env = PVR_TXRENV_MODULATE;
+			context.gen.specular = add;
+			pvr_poly_compile(&header, &context);
+			send_header(&header);
+			last_image = quad->image;
+			last_add = add;
+		}
+		quad_vertices(quad, (float)pvr_images.width[quad->image], (float)pvr_images.height[quad->image]);
+	}
+	pvr_list_finish();
+	pvr_scene_finish();
+	if (stats)
+	{
+		stats->build_us = (uint32_t)(built - start);
+		stats->wait_us = (uint32_t)(ready - built);
+		stats->submit_us = (uint32_t)(timer_us_gettime64() - ready);
+	}
+}
diff --git a/ports/naomi/pvr_video.h b/ports/naomi/pvr_video.h
new file mode 100644
index 0000000..a41e82f
--- /dev/null
+++ b/ports/naomi/pvr_video.h
@@ -0,0 +1,33 @@
+/**
+ *    Name:        pvr_video.h
+ *    Description: the frame on the NAOMI's PowerVR2 (pvr_video.c)
+ *    Created:     13-11-2026
+ *
+ *    license:BSD-3-Clause
+ */
+#ifndef ORUNNERS_PVR_VIDEO_H
+#define ORUNNERS_PVR_VIDEO_H
+
+#include <stdint.h>
+
+typedef struct
+{
+	int quads;
+	int images_drawn;          /* this frame: tiles, bitmap rows and sprites (re)made */
+	int texels_drawn;
+	uint32_t missing;          /* S32_SCENE_MISSING_ bits */
+	int images;                /* textures held */
+	int failed;                /* times there was no room for one (all along) */
+	uint32_t video_memory_free;
+	uint32_t build_us;         /* the scene worked out (s32_scene_build) */
+	uint32_t wait_us;          /* waiting for the PowerVR2 to take a new scene */
+	uint32_t submit_us;        /* the quads handed to it */
+} pvr_video_stats;
+
+/* The PowerVR2 on, the scene on it (video.c then draws no sprites of its own) */
+void pvr_video_start(void);
+
+/* The board's frame now, drawn (waits for the PowerVR2 to take a new scene) */
+void pvr_video_frame(pvr_video_stats *stats);
+
+#endif
diff --git a/ports/naomi/race.py b/ports/naomi/race.py
new file mode 100644
index 0000000..bf743ce
--- /dev/null
+++ b/ports/naomi/race.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""race.py LIVE_ADDR [SECONDS]: a race with no one at the cabinet (the live block's test_inputs): a coin, START
+pressed until the race starts, then full gas, the wheel swinging a little; the live figures once a second.
+At the end the cabinet's own controls again (test_inputs 0). Runs on the netbooter's Raspberry, as live.py."""
+import sys, time
+sys.path.append('/sbin/piforce/dm_netboot')
+from netdimm import NetDimm, PeekPokeTypeEnum as T
+
+d = NetDimm('10.0.0.4')
+off = lambda a: a & 0x01ffffff
+base = int(sys.argv[1], 0)
+seconds = int(sys.argv[2]) if len(sys.argv) > 2 else 60
+peek = lambda o: d.peek(off(base + o), T.TYPE_LONG)
+poke = lambda o, v: d.poke(off(base + o), T.TYPE_LONG, v)
+if peek(0) != 0x4e55524f:
+    sys.exit('no live block')
+ON = 0x80000000
+poke(0x74, ON | 1)                      # a coin
+time.sleep(1.5)
+for _ in range(12):                     # START through the screens before the race
+    poke(0x74, ON | 2); time.sleep(0.3)
+    poke(0x74, ON); time.sleep(0.7)
+start, last = time.time(), None
+while time.time() - start < seconds:
+    t = time.time() - start
+    wheel = 0x80 + int(40 * ((t // 3) % 3 - 1))
+    poke(0x74, ON | 0xff << 8 | wheel << 16)
+    s = peek(0x08)
+    if s != last:
+        last = s
+        f = [peek(o) for o in (0x0c, 0x14, 0x18, 0x1c, 0x68, 0x6c, 0x70, 0x20, 0x54, 0x58, 0x5c)]
+        print('%4ds  game %2d fps  game %5d  sound %5d  video %5d (build %5d wait %5d submit %4d)  worst %6d  '
+              'quads %3d  texels %6d/s  missing %04x' % ((s,) + tuple(f)), flush=True)
+    time.sleep(0.25)
+poke(0x74, 0)
diff --git a/runtime/include/s32/video_scene.h b/runtime/include/s32/video_scene.h
new file mode 100644
index 0000000..d1d3f32
--- /dev/null
+++ b/runtime/include/s32/video_scene.h
@@ -0,0 +1,96 @@
+/**
+ *    Name:        video_scene.h
+ *    Description: the frame as textured quads instead of pixels (ORUNNERS_VIDEO_SCENE): for a GPU that draws
+ *                 them, the NAOMI's PowerVR2 first (ports/naomi/pvr_video.c)
+ *    Created:     13-11-2026
+ *
+ *    license:BSD-3-Clause
+ *    What it covers is what OutRunners uses of the chips (docs/outrunners.md of 0skarzer0/naomi-wheel-games): the
+ *    text layer, NBG0 (scroll and zoom), NBG2 (scroll, row scroll, row select), the backdrop, the sprites (zoom,
+ *    flips, 8 bits, indirect colours, the list's clip rectangle) and the mixer's priorities and colour offsets.
+ *    Not covered (yet): NBG1, NBG3, the bitmap, clip windows, blending, shadows, the list's outside clip, the
+ *    screens' flips, WIDE. Left screen only.
+ *
+ *    The scene keeps images of 16-bit pixels (ARGB1555: bit 15 opaque, red in 14-10) that a backend holds
+ *    (in video memory, say): the tilemap pages and the text map, redrawn where their cells or colours change,
+ *    and the sprites' images, one per graphics and colours, kept while they are used. Quads say where an image's
+ *    texels go on the 320 x 224 screen, at what depth (higher in front) and with what colour.
+ */
+#ifndef S32_VIDEO_SCENE_H
+#define S32_VIDEO_SCENE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Where the images live. Sizes are powers of two, at most 1024 x 512 */
+typedef struct
+{
+	void *context;
+	/* an image of width x height texels, its handle (1 or more), or 0 when there is no room */
+	int (*image_create)(void *context, int width, int height);
+	void (*image_free)(void *context, int image);
+	/* width x height texels at (x, y) of an image, 'stride' texels a row in 'pixels'; width is even */
+	void (*image_write)(void *context, int image, int x, int y, int width, int height, const uint16_t *pixels,
+		int stride);
+} s32_scene_backend;
+
+/* One quad: its screen rectangle (pixels, the left and top edges in, the right and bottom out), the image's
+   texels at its corners (u0, v0 at x0, y0; u1, v1 at x1, y1: a flip has them the other way), its depth, and the
+   colour it takes: each channel times modulate's (0-255 each, 0x00RRGGBB: 255 keeps it), plus add's (0-255 each,
+   0x00RRGGBB). Image 0 is no image: a plain 'colour' (ARGB1555, opaque). Texels whose bit 15 is clear are not
+   drawn */
+typedef struct
+{
+	float x0, y0, x1, y1;
+	float u0, v0, u1, v1;
+	float z;
+	int image;
+	uint16_t colour;
+	uint32_t modulate;
+	uint32_t add;
+} s32_scene_quad;
+
+typedef struct
+{
+	const s32_scene_quad *quads;
+	int count;
+	/* what the frame needed that the scene does not cover, as bits (S32_SCENE_MISSING_), for the log */
+	uint32_t missing;
+	/* the work done: images (re)drawn, their texels */
+	int images_drawn;
+	int texels_drawn;
+} s32_scene_frame;
+
+#define S32_SCENE_MISSING_NBG1      0x0001u
+#define S32_SCENE_MISSING_NBG3      0x0002u
+#define S32_SCENE_MISSING_BITMAP    0x0004u
+#define S32_SCENE_MISSING_WINDOWS   0x0008u
+#define S32_SCENE_MISSING_BLEND     0x0010u
+#define S32_SCENE_MISSING_SHADOW    0x0020u
+#define S32_SCENE_MISSING_OUTSIDE   0x0040u
+#define S32_SCENE_MISSING_FLIP      0x0080u
+#define S32_SCENE_MISSING_SHIFT     0x0100u
+#define S32_SCENE_MISSING_IMAGES    0x0200u    /* the backend had no room for an image */
+#define S32_SCENE_MISSING_FROM_RAM  0x0400u
+
+/* Starts the scene on 'backend' (kept by the caller). With 'only', the video draws no sprites into its own
+   buffers any more (s32_video_draw_frame then misses them: the scene alone shows the frame) */
+void s32_scene_start(const s32_scene_backend *backend, bool only);
+
+/* The frame the board shows now, as quads (valid until the next call) */
+const s32_scene_frame *s32_scene_build(void);
+
+/* For comparisons: the scene built each time video.c draws a frame (at the same moment, from the same state),
+   and the last one built so */
+void s32_scene_follow_frames(bool follow);
+const s32_scene_frame *s32_scene_last(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
